# Copy to .env (or export these directly) and fill in what you need.
# repolens never logs or persists these values outside your local config.

# Which LLM backend `repolens ask` should use: anthropic | openai | ollama
REPOLENS_PROVIDER=anthropic

# Only the variable matching REPOLENS_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Optional: override the default model for the chosen provider.
REPOLENS_MODEL=

# Optional: token for cloning private GitHub/GitLab repos over HTTPS.
# Needs `repo` scope. Generate at https://github.com/settings/tokens
GITHUB_TOKEN=
