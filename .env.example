# Copy to .env (or export these directly) and fill in what you need.
# graphsentry never logs or persists these values outside your local config.

# Which LLM backend `graphsentry ask` should use: anthropic | openai | ollama
GRAPHSENTRY_PROVIDER=anthropic

# Only the variable matching GRAPHSENTRY_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Optional: override the default model for the chosen provider.
GRAPHSENTRY_MODEL=
